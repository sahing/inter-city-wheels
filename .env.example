APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Demo mode: one-tap role login, simulated Firebase/Clerk providers, and OTP echo.
# Enabled automatically when APP_ENV is not "production". MUST be false in production.
# INTERCITY_DEMO_MODE=false

# Production admin account, used by the seeder when demo mode is off.
# ADMIN_EMAIL=ops@yourdomain.com
# ADMIN_PASSWORD=
# ADMIN_NAME="Platform Admin"
# ADMIN_PHONE=

# Fast2SMS OTP Gateway Configuration
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=otp

# Firebase Authentication Configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
# Optional: pin the accepted token audience to one OAuth client id
FIREBASE_CLIENT_ID=
# Local demos only. Default: true unless APP_ENV=production, where the server
# requires a verified ID token for every Firebase sign-in.
# FIREBASE_ALLOW_ID_ONLY=true

# Clerk Authentication Configuration
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# OpenStreetMap: Nominatim place search + OSRM driving distance
# Public instances are rate-limited; self-host or use a provider for production.
OSM_ENABLED=true
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_OSRM_URL=https://router.project-osrm.org
OSM_USER_AGENT="IntercityWheels/2.0 (+https://intercitywheels.com)"
OSM_COUNTRY_CODES=in
OSM_TIMEOUT=3
OSM_THROTTLE=true
OSM_CACHE_TTL=604800
OSM_ROUTE_CACHE_TTL=43200
# Persist measured routes/places in the database (geo_route_cache, geo_place_cache)
OSM_DB_CACHE=true
OSM_ROUTE_TTL_DAYS=30
OSM_PLACE_TTL_DAYS=90
